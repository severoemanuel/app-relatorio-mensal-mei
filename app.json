{
  "expo": {
    "name": "geradorelatoriomei",
    "slug": "geradorelatoriomei",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/assets/images/GRMEI.png",
    "scheme": "admmei",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.quadrinhos.geradorelatoriomei",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/GRMEI.png",
        "backgroundColor": "#5d15eb"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/GRMEI.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#5d15eb"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "206da602-1c5b-4b4c-98b9-7360972059c7"
      }
    }
  }
}